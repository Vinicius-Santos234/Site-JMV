NEXT_PUBLIC_GA_MEASUREMENT_ID=G-XXXXXXXXXX   # Google Analytics (opcional)
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxx # Necessário para o formulário de contato
# Sanity CMS — todo o conteúdo do site (portfólio, serviços, clientes, depoimentos,
# FAQs, etc.). Sem estas variáveis, o site usa os dados locais (src/data/*.js) como
# fallback automático. SEM prefixo NEXT_PUBLIC_: desde a migração para o Next a
# busca acontece no servidor (src/lib/content.js), não no navegador.
SANITY_PROJECT_ID=xxxxxxxx       # Project ID do Sanity
SANITY_DATASET=production
# Usado SÓ pelo seed (scripts/seed-sanity.mjs) para popular o dataset. Token de
# editor gerado em sanity.io/manage. Não vai para o frontend; mantenha fora do git.
SANITY_WRITE_TOKEN=sk_xxxxxxxxxxxxxxxx
# RATE LIMITING — nao precisa de variavel nenhuma desde 09/2026.
# Quem limita e uma regra do Vercel Firewall, na borda:
#   contato-rate-limit — 5 req / 600s por IP em POST /api/contact
# Conferir com: vercel firewall rules list
# (Antes era @upstash/ratelimit + Vercel KV. O banco do Upstash foi removido
#  por inatividade e o limite caiu em silencio para in-memory por semanas.)
# Cloudflare Turnstile — CAPTCHA invisível do formulário de contato. Sem estas
# variáveis, o CAPTCHA fica desativado (o formulário segue funcionando). A site
# key é pública (frontend); a secret é usada só no servidor.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=0x4AAAAAAxxxxxxxxxxxxxx
TURNSTILE_SECRET_KEY=0x4AAAAAAxxxxxxxxxxxxxx