VITE_GA_MEASUREMENT_ID=G-XXXXXXXXXX   # Google Analytics (opcional)
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxx # Necessário para o formulário de contato
# Sanity CMS — portfólio. Sem estas variáveis, o site usa os dados locais
# (src/data/portfolio-full.js) como fallback automático.
VITE_SANITY_PROJECT_ID=xxxxxxxx       # Project ID do Sanity
VITE_SANITY_DATASET=production
# Vercel KV (Upstash) — rate limiting persistente da API de contato. Sem estas
# variáveis, o rate limiting cai para in-memory (best-effort). Geradas ao criar
# o KV no dashboard da Vercel (Storage → KV).
KV_REST_API_URL=https://xxxxxxxx.upstash.io
KV_REST_API_TOKEN=xxxxxxxxxxxxxxxxxxxx
# Cloudflare Turnstile — CAPTCHA invisível do formulário de contato. Sem estas
# variáveis, o CAPTCHA fica desativado (o formulário segue funcionando). A site
# key é pública (frontend); a secret é usada só no servidor.
VITE_TURNSTILE_SITE_KEY=0x4AAAAAAxxxxxxxxxxxxxx
TURNSTILE_SECRET_KEY=0x4AAAAAAxxxxxxxxxxxxxx